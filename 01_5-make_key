#!/usr/bin/bash
set -e

WD=$PWD

cd build/src
. build/envsetup.sh
. $WD/common.sh

mkdir -p keys/
cd keys/
SUBJECT="/C=ID/ST=South Sumatera/L=Palembang/O=null2264/OU=null2264/CN=null2264/emailAddress=me@aap.my.id"

if [ -f ./make_key ]; then
    cp ../development/tools/make_key ./make_key
    sed -i 's|2048|4096|g' ./make_key
fi

for key in ${signing_keys[@]}; do
    echo "Generating $cert certificate.."
    echo "" | ./make_key "$cert" "$SUBJECT"
    openssl pkcs8 -in "${cert}.pk8" -inform DER -nocrypt -out "${cert}.pem"
done

cd ../
