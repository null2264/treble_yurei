Subject: [PATCH 11/55] Always allow overriding the number of work profiles

Change-Id: I6eb09aa71663c6fbe7563e3038bffcabdba0ff6a
---
 services/core/java/com/android/server/pm/UserTypeDetails.java | 4 ++++
 1 file changed, 4 insertions(+)

diff --git a/services/core/java/com/android/server/pm/UserTypeDetails.java b/services/core/java/com/android/server/pm/UserTypeDetails.java
index 0823f2bdc..2499fb199 100644
--- a/services/core/java/com/android/server/pm/UserTypeDetails.java
+++ b/services/core/java/com/android/server/pm/UserTypeDetails.java
@@ -27,6 +27,7 @@ import android.content.pm.UserInfo.UserInfoFlag;
 import android.content.pm.UserProperties;
 import android.content.res.Resources;
 import android.os.Bundle;
+import android.os.SystemProperties;
 import android.os.UserManager;
 
 import com.android.internal.util.Preconditions;
@@ -239,6 +240,9 @@ public final class UserTypeDetails {
 
     /** Returns the maximum number of this user type allowed on the device. */
     public int getMaxAllowed() {
+        if (isManagedProfile()) {
+            return SystemProperties.getInt("persist.sys.max_profiles", mMaxAllowed);
+        }
         return mMaxAllowed;
     }
 
