From b12504708c8177ded23b22580cdaa5777deaee61 Mon Sep 17 00:00:00 2001
From: Pierre-Hugues Husson <phh@phh.me>
Date: Sun, 31 Mar 2024 17:18:05 -0400
Subject: [PATCH 21/23] If AVB fails, ignore/disable AVB

DO NOT INCLUDE THIS PATCH If you want to run GSIs on a locked bootloader

This is needed on Honor View 10 which declares "avb" in fstab while
being AVB1.0
---
 init/first_stage_init.cpp          | 6 +++++-
 init/first_stage_mount.cpp         | 4 +++-
 init/first_stage_mount_android.cpp | 6 ++++++
 3 files changed, 14 insertions(+), 2 deletions(-)

diff --git a/init/first_stage_init.cpp b/init/first_stage_init.cpp
index b5fdfac..c6e9095 100644
--- a/init/first_stage_init.cpp
+++ b/init/first_stage_init.cpp
@@ -555,7 +555,11 @@ int FirstStageMain(int argc, char** argv) {
         }
 
         if (!created_devices && !fsm->DoCreateDevices()) {
-            LOG(FATAL) << "Failed to create devices required for first stage mount";
+            LOG(ERROR) << "Failed to create devices required for first stage mount, retrying without avb";
+            fsm = CreateFirstStageMount(cmdline + " no_vbmeta");
+            if(!fsm->DoCreateDevices()) {
+                LOG(FATAL) << "Failed to create devices required for first stage mount, retrying without avb";
+            }
         } else if (REBOOT_BOOTLOADER_ON_PANIC && !AttemptingToBootNewSlot()) {
             InstallRebootSignalHandlers();
         }
diff --git a/init/first_stage_mount.cpp b/init/first_stage_mount.cpp
index c445a41..c76e3ef 100644
--- a/init/first_stage_mount.cpp
+++ b/init/first_stage_mount.cpp
@@ -105,7 +105,9 @@ bool FirstStageMount::DoFirstStageMount() {
         return true;
     }
 
-    if (!MountPartitions()) return false;
+    if (!MountPartitions()) {
+        return false;
+    }
 
     return true;
 }
diff --git a/init/first_stage_mount_android.cpp b/init/first_stage_mount_android.cpp
index 09222de..e48e0e4 100644
--- a/init/first_stage_mount_android.cpp
+++ b/init/first_stage_mount_android.cpp
@@ -58,6 +58,12 @@ Result<std::unique_ptr<FirstStageMount>> FirstStageMount::Create(const std::stri
 
     // Select first_stage_mount entries
     std::erase_if(fstab, [](auto& entry) { return !entry.fs_mgr_flags.first_stage_mount; });
+    if (cmdline.find("no_vbmeta") != std::string::npos) {
+        for(auto& part: fstab) {
+            part.avb_keys = "";
+            part.fs_mgr_flags.avb = false;
+        }
+    }
     return std::make_unique<FirstStageMountAndroid>(std::move(fstab), data_on_userdata);
 }
 
