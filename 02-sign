#!/usr/bin/bash
set -e

WD=$PWD
# REF: https://grapheneos.org/build#generating-release-signing-keys
KEY_DIR="$WD/keys"

cd build/src
. build/envsetup.sh
. $WD/common.sh

V="user"; [ "$DEBUG" = "true" ] && V="userdebug"

GRAPHENEOS_TAG="2026061600"
