ANDROID_VERSION=$(echo "${AOSP_TAG}" | sed "s/android-//;s/_r.*//")
ANDROID_VERSION_TAG=$(grep -m1 "target:" build/release/release_config_map.textproto | sed 's/.*"\([^"]*\)".*/\1/')

lunch "treble_arm64_bvN-${ANDROID_VERSION_TAG}-${V}"

TARGET_FILES=$(ls $OUT/obj/PACKAGING/target_files_intermediates/treble_arm64_bvN-target_files.zip | head -n 1)

echo "==> Resigning target files using keys from $KEY_DIR..."

AVB_PKMD="$KEY_DIR/avb_pkmd.bin"
AVB_ALGORITHM=SHA256_RSA4096

# REF: https://github.com/GrapheneOS/script/blob/16-qpr2/generate-release.sh#L74
